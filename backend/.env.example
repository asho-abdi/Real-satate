# Server
NODE_ENV=development
PORT=5000
APP_NAME=RJK Realty API
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Optional extra origins (comma-separated). FRONTEND_URL is always allowed.
CORS_ORIGINS=
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Realstate?schema=public

# JWT (use long random values; production rejects placeholders)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Set true after HTTPS is live (Secure cookie flag). Auto-true when FRONTEND_URL is https://
COOKIE_SECURE=false
# Optional dedicated key for MFA secret encryption (defaults to JWT_ACCESS_SECRET)
# MFA_ENCRYPTION_KEY=

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Email (optional in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RJK Realty <noreply@localhost>"

# Seed (development defaults). Production requires SEED_ADMIN_PASSWORD.
SEED_ADMIN_EMAIL=admin@estateops.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Owner

# --- Production template ---
# See backend/.env.production.example
