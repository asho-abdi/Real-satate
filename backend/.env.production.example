# ============================================================
# RJK Realty API — PRODUCTION environment template
# Copy to backend/.env on the server (never commit the real file)
#   cp backend/.env.production.example backend/.env
# ============================================================

NODE_ENV=production
PORT=5000
APP_NAME=RJK Realty API
APP_URL=https://api.your-domain.com
FRONTEND_URL=https://app.your-domain.com
# Optional extra browser origins (comma-separated)
CORS_ORIGINS=https://app.your-domain.com,https://your-domain.com
API_PREFIX=/api/v1

# PostgreSQL — use a strong password and SSL if your host requires it
# Example (Neon/Supabase/Railway): append ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/Realstate?schema=public&sslmode=require

# JWT — generate unique secrets (min 32 chars, no placeholders)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email (recommended so password reset works)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RJK Realty <noreply@your-domain.com>"

# First-time seed only (required when NODE_ENV=production)
# Used by: npm run prisma:seed --workspace=@real-state/backend
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Owner
