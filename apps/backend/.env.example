# Server
NODE_ENV=development
PORT=5000
APP_NAME=EstateOps API
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estateops?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email (optional in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EstateOps <noreply@estateops.local>"
