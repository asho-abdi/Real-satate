# Copy to apps/api/.env

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase project (same as web app)
SUPABASE_URL=https://mdathdtmsiwwgbxgponu.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Optional in local development (falls back to anon key; RLS may block writes).
# Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# Domain schema
SUPABASE_DB_SCHEMA=real_estate

# Require Authorization: Bearer <supabase_access_token> when true
REQUIRE_AUTH=false
