{
  "name": "real-state",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@real-state/frontend",
    "dev:frontend": "npm run dev --workspace=@real-state/frontend",
    "dev:backend": "npm run dev --workspace=@real-state/backend",
    "build": "npm run build --workspace=@real-state/frontend",
    "build:frontend": "npm run build --workspace=@real-state/frontend",
    "preview:frontend": "npm run preview --workspace=@real-state/frontend",
    "start:backend": "npm run start --workspace=@real-state/backend",
    "prisma:generate": "npm run prisma:generate --workspace=@real-state/backend",
    "prisma:push": "npm run prisma:push --workspace=@real-state/backend",
    "prisma:seed": "npm run seed --workspace=@real-state/backend",
    "db:backend": "npm run db:setup --workspace=@real-state/backend"
  }
}
